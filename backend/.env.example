# ---- Avighna BOQ API (local build) ----
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO
DATA_DIR=./data                      # uploads, previews, exports, sqlite db live here
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# First admin account (created on first start if no users exist). Change the password after first login.
BOOTSTRAP_ADMIN_EMAIL=admin@avighnagroup.com
BOOTSTRAP_ADMIN_PASSWORD=Avighna@2026
BOOTSTRAP_ADMIN_NAME=Avighna Admin
JWT_EXPIRES_HOURS=12
# JWT_SECRET=                        # optional; auto-generated into data/.jwt_secret when empty

# Gemini (drawing reading). Leave empty to run with AI disabled (deterministic extraction only).
GEMINI_API_KEY=
GEMINI_MODEL_FAST=auto               # or e.g. gemini-2.5-flash
GEMINI_MODEL_PRO=auto                # or e.g. gemini-2.5-pro
GEMINI_TIMEOUT_S=180
GEMINI_MAX_IMAGE_PX=3000

# DWG -> DXF converters (first one found is used)
ODA_CONVERTER_BIN=ODAFileConverter
# LIBREDWG_BIN=                      # optional override; default order: ~/.local/opt/libredwg-0.13.4, conda env, PATH
CONVERSION_TIMEOUT_S=300

MAX_UPLOAD_MB=200
WORKER_THREADS=2
PREVIEW_DPI=110
